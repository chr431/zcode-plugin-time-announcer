{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/scripts/hook.cjs", "session-start"],
            "timeoutMs": 5000,
            "statusMessage": "time-announcer: 初始化时钟状态"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/scripts/hook.cjs", "user-prompt-submit"],
            "timeoutMs": 5000,
            "statusMessage": "time-announcer: 采样当前时间"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/scripts/hook.cjs", "post-tool-use"],
            "timeoutMs": 5000
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/scripts/hook.cjs", "post-tool-use-failure"],
            "timeoutMs": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/scripts/hook.cjs", "stop"],
            "timeoutMs": 5000
          }
        ]
      }
    ]
  }
}
